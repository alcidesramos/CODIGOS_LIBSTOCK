  I2C1_Wr ( 0X78 );
  I2C1_Wr ( 0x60 );

 for(x_pos =  0 ; x_pos <  128 ; x_pos++)
 {
  I2C1_Wr (bmp_data);
 }

  I2C1_Stop ();
 }
}


void OLED_print_Image(const unsigned char *bmp, unsigned char pixel)
{
