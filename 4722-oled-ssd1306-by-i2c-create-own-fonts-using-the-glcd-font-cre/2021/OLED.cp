 unsigned char page = 0;

 if(pixel !=  0 )
 {
 pixel = 0xFF;
 }
 else
 {
 pixel = 0x00;
 }

 for(page = 0; page <  8 ; page++)
 {
 OLED_gotoxy( 0 , page);

  I2C1_Start ();
  I2C1_Wr ( 0X78 );
  I2C1_Wr ( 0x60 );

 for(x_pos =  0 ; x_pos <  128 ; x_pos++)
 {
  I2C1_Wr ((*bmp++ ^ pixel));
 }

  I2C1_Stop ();
 }
}


void OLED_clear_screen()
