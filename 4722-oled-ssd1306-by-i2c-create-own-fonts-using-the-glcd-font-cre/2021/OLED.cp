 }
 else if((value > 9) && (value <= 99))
 {
 ch = ((value % 100) / 10);
 OLED_print_char((x_pos + columnas_med), y_pos , (48 + ch),font_t);
 ch = (value % 10);
 OLED_print_char((x_pos + columnas_med*2), y_pos , (48 + ch),font_t);
 OLED_print_char((x_pos + columnas_med*3), y_pos , 32,font_t);
