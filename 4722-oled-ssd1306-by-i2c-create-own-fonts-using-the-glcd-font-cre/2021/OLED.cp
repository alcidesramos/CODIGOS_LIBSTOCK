char texto[30];
signed int cuenta=-5;


void main()
{
 adcon1=0b1111;

 OLED_init();
 OLED_print_text(0,0,"HOLA",&font1);

 OLED_print_text(6,3,"ARZ",&font2);

 OLED_scroll_der(0,5);
 Delay_ms(2000);
 OLED_scroll_izq(0,5);
 Delay_ms(2000);


 while(1)
 {
 sprintf(texto,"%3d",cuenta++);
 OLED_print_text(5,6,texto,&font1);
 Delay_ms(100);

 if (cuenta==8) OLED_stop_scroll();



 }



 Delay_ms(1000);
 OLED_clear_screen();



 OLED_print_Image(&truck, 0 );




 Delay_ms(3000);
 OLED_clear_screen();



 OLED_print_Image(&carsun, 1 );



 while (1)
 {


 }



}
